# Tier DD (delay-difference) specifications; two values = prior mean, SD
#Tier_DD:Cpue_Area 1              # CPUE index used to derive effort (= catch / CPUE)
#Tier_DD:Cpue_Index 1             # fleet 1 East_TwlOnbd
#Tier_DD:Len_Area 1
#Tier_DD:Len_Fleet 1              # length comps used for the moments
#Tier_DD:Len_Part 2               # 2 = retained
#Tier_DD:MaxNsamp 1000            # cap on the stated sample size (EFN)
#Tier_DD:kage 3                   # age at entry to the model (group 1)
#Tier_DD:Amax 100
#Tier_DD:gamma_sr 1               # 1 = Beverton-Holt
#Tier_DD:beta_init 0.893          # BH with steepness 0.7: beta = (1-0.2/h)/0.8
#Tier_DD:EstBeta No
#Tier_DD:sigmaC 0.05
#Tier_DD:sigmaE 0.3
#Tier_DD:sigmaR 0.7
#Tier_DD:lamM 0                   # mean weight: 0 = off (derived from the same lengths)
#Tier_DD:lamL 1 1 1 1             # SD multipliers for length moments 1-4
#Tier_DD:Rho 0.79 0.05            # exp(-k), k = 0.236
#Tier_DD:Surv 0.861 0.03          # exp(-M), M = 0.15
#Tier_DD:Entry 0.4 0.15           # annual probability of moving to the fished group
#Tier_DD:Tauk 21.45 1.5           # length at age 3
#Tier_DD:Linf_init 35.5
#Tier_DD:EstLinf Yes
#Tier_DD:Sigtau 3                 # within-age SD of length (CV 0.10 at ~30 cm)
#Tier_DD:Q2 0 0.5
#Tier_DD:EstQ2 No
#Tier_DD:Q1sd -1                  # no prior on Q1
#Tier_DD:MaxLen_g1 26             # soft upper bound on group-1 mean length
#Tier_DD:lamPen 100
#Tier_DD:B0_init_mult 10
#Tier_DD:RecDevLead 3
#Tier_DD:Dlim 0.2                 # PLACEHOLDER HCR on fishable-biomass depletion
#Tier_DD:Dtarg 0.48
#Tier_DD:Htarg 0.1

